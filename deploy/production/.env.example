# ArcReel 生产环境配置（PostgreSQL）
# 复制为 .env 后填入你的值

# ============================================================
# 认证配置 (Authentication)
# ============================================================
# 登录用户名（默认: admin）
AUTH_USERNAME=admin
# 登录密码（留空则首次启动时自动生成并回写到 .env 文件）
AUTH_PASSWORD=
# JWT 签名密钥（留空则自动生成，但重启后 token 失效需重新登录）
AUTH_TOKEN_SECRET=

# ============================================================
# PostgreSQL 配置
# ============================================================
# 数据库密码（必填，docker-compose 启动时会校验）
# 仅使用字母数字，避免 URL 特殊字符（@#/?% 等）导致 DATABASE_URL 解析失败
# 生成方法: openssl rand -hex 16
POSTGRES_PASSWORD=

# Java 身份服务调用内部通知网关的共享令牌（建议至少 32 字节随机值）。
XINGJING_IDENTITY_NOTIFICATION_TOKEN=

# 密码重置邮件发送配置。
XINGJING_PUBLIC_APP_URL=https://your-xingjing.example.com
XINGJING_SMTP_HOST=
XINGJING_SMTP_PORT=587
XINGJING_SMTP_SECURITY=starttls
XINGJING_SMTP_USERNAME=
XINGJING_SMTP_PASSWORD=
XINGJING_SMTP_FROM=星镜剧创 <no-reply@your-xingjing.example.com>

# M03/M04/M05 use the PostgreSQL URLs assembled in docker-compose.yml above.
# Their object storage roots are mounted under ./projects and require no secret.

# ============================================================
# M06 生成 Provider（如未配置，生成提交接口会明确返回不可用）
# ============================================================
# 以下配置指向你部署的生成 Provider 网关；Provider 需在回调时携带
# X-Xingjing-Provider-Signature: sha256=<HMAC-SHA256(raw body)>。
XINGJING_M06_PROVIDER_ID=
XINGJING_M06_PROVIDER_MODEL_ID=
XINGJING_M06_PROVIDER_SUBMIT_URL=
XINGJING_M06_PROVIDER_CANCEL_URL=
XINGJING_M06_PROVIDER_TOKEN=
XINGJING_M06_PROVIDER_CALLBACK_SECRET=
XINGJING_M06_ESTIMATED_COST_MINOR=100
XINGJING_M06_BILLING_CURRENCY=CNY
XINGJING_M06_PRICING_VERSION=default-v1
XINGJING_M06_MAX_ACTIVE_TASKS=20
XINGJING_M06_BILLING_CALLBACK_SECRET=replace-with-at-least-32-random-characters
XINGJING_M06_PROVIDER_RECOVERY_SECRET=replace-with-at-least-32-random-characters
XINGJING_M06_MODEL_CATALOG_JSON=[{"providerId":"provider","modelId":"model","displayName":"Production Model","version":"1","region":"cn","mediaTypes":["image","video"],"capabilities":["generation","image_generation","character_turnaround","character_expressions","image_to_video","text_to_video","video_generation","first_last_video","image_edit","inpaint","reference_fusion","image_upscale","video_candidates","video_extend","video_retry","video_stabilize","video_upscale"],"active":true}]

# ============================================================
# M07 音频 / 字幕 / 对口型 Provider
# ============================================================
# Provider 成功或失败后须 POST 到 /api/v1/audio-providers/callbacks，并携带
# X-Xingjing-Provider-Signature: sha256=<HMAC-SHA256(raw body)>。
# 成功回调的输出文件需先写入容器中 /app/projects 下的相对路径；服务端会将其
# 复制到受租户、工作区、项目隔离的 M07 产物目录，再保存对象 key 与摘要。
XINGJING_M07_PROVIDER_ID=
XINGJING_M07_PROVIDER_SUBMIT_URL=
XINGJING_M07_PROVIDER_CHECK_URL=
XINGJING_M07_PROVIDER_CANCEL_URL=
XINGJING_M07_PROVIDER_TOKEN=
XINGJING_M07_PROVIDER_CALLBACK_SECRET=
XINGJING_M07_TASK_TIMEOUT_SECONDS=21600
XINGJING_M07_BILLING_CURRENCY=CNY
XINGJING_M07_PRICING_VERSION=
XINGJING_M07_ESTIMATED_COSTS_JSON={"audio":100,"subtitle":20,"lip_sync":300,"mix":180}

# ============================================================
# M08 成片渲染器 / M09 正式导出
# ============================================================
# M08 渲染器必须把完成产物写入共享的 /app/projects/xingjing-render-objects
# 目录，并通过签名回调登记不可变成片版本。M09 只会从该版本生成正式交付。
XINGJING_EDITING_RENDERER_URL=
XINGJING_EDITING_RENDERER_TOKEN=
XINGJING_EDITING_CALLBACK_SECRET=
XINGJING_EDITING_TIMEOUT_SWEEP_SECONDS=30
XINGJING_EDITING_BILLING_CURRENCY=CNY
XINGJING_EDITING_BILLING_PRICING_VERSION=render-2026-07
XINGJING_EDITING_BILLING_MINOR_PER_MEGAPIXEL_SECOND=
XINGJING_MAX_REQUEST_BODY_BYTES=16777216
XINGJING_RATE_LIMIT_AUTH_PER_MINUTE=20
XINGJING_RATE_LIMIT_UPLOAD_PER_MINUTE=60
XINGJING_RATE_LIMIT_TASK_PER_MINUTE=120
XINGJING_RATE_LIMIT_ADMIN_PER_MINUTE=60
XINGJING_RATE_LIMIT_API_PER_MINUTE=600
# M09 正式交付目录由服务启动时在共享 projects 卷中创建，无需另填路径。
XINGJING_COMPLIANCE_PROVIDER_URL=
XINGJING_COMPLIANCE_PROVIDER_TOKEN=
# 只有法务和商业发布条件确认后才能改为 true。
XINGJING_COMMERCIAL_EXPORT_ENABLED=false
XINGJING_BILLING_CALLBACK_SECRET=replace-with-at-least-32-random-characters
XINGJING_PAYMENT_CALLBACK_SECRET=replace-with-at-least-32-random-characters

# ============================================================
# 日志配置 (Logging)
# ============================================================
# 日志级别（默认: INFO，可选: DEBUG, WARNING, ERROR）
# LOG_LEVEL=INFO
XINGJING_TASK_WORKER_TOKEN=replace-with-a-long-random-worker-token
COMFYUI_URL=http://comfyui:8188
COMFY_GATEWAY_TOKEN=replace-with-a-long-random-comfy-gateway-token
MEDIA_WORKER_TOKEN=replace-with-a-long-random-media-worker-token
MEDIA_TASK_TIMEOUT_SECONDS=3600
MEDIA_MAX_OUTPUT_BYTES=21474836480
XINGJING_MODEL_CONTROL_TOKEN=replace-with-a-long-random-model-control-token
# 生成方式：python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
XINGJING_CREDENTIAL_ENCRYPTION_KEY=replace-with-urlsafe-base64-32-byte-key
